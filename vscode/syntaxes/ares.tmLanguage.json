{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ares",
  "scopeName": "source.ares",
  "fileTypes": ["ares"],
  "patterns": [{ "include": "#item" }, { "include": "#expr" }],
  "repository": {
    "item": {
      "patterns": [
        {
          "match": "^(\\$)\\s*(@mod)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.item.ares" },
            "2": { "name": "keyword.other.module.ares" },
            "3": { "name": "entity.name.namespace.ares" }
          }
        },
        {
          "match": "^(\\$)\\s*(@import)\\s+(?:[A-Z][A-Za-z0-9_]*\\s*=\\s*)?([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "punctuation.definition.item.ares" },
            "2": { "name": "keyword.control.import.ares" },
            "3": { "name": "entity.name.namespace.ares" }
          }
        },
        {
          "match": "^(\\$)\\s*([A-Z][A-Za-z0-9_]*|@I[A-Z][A-Za-z0-9_]*)\\s*(:)\\s*(@struct|@union|@alias|@effect)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.item.ares" },
            "2": { "name": "entity.name.type.ares" },
            "3": { "name": "punctuation.separator.type.ares" },
            "4": { "name": "storage.type.ares" }
          }
        },
        {
          "match": "^(\\$)\\s*([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.item.ares" },
            "2": { "name": "entity.name.function.ares" }
          }
        },
        {
          "match": "^(\\$)\\s*(\\()([!$%&*+\\-/:;<=>^|~]+)(\\))",
          "captures": {
            "1": { "name": "punctuation.definition.item.ares" },
            "3": { "name": "entity.name.function.operator.ares" }
          }
        },
        {
          "match": "^(\\$)\\s*(@main|@build|@private|&)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.item.ares" },
            "2": { "name": "keyword.other.directive.ares" }
          }
        }
      ]
    },
    "expr": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#at" },
        { "include": "#keyword" },
        {
          "match": "\\?\\?\\?",
          "name": "invalid.deprecated.hole.ares"
        },
        {
          "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*)\\s*(?==[^=>])",
          "captures": {
            "1": { "name": "punctuation.accessor.ares" },
            "2": { "name": "variable.other.property.ares" }
          }
        },
        {
          "match": "(?<=\\.)[a-z_][A-Za-z0-9_]*",
          "name": "variable.other.property.ares"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?![:=])",
          "captures": {
            "1": { "name": "variable.other.property.ares" }
          }
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.ares"
        },
        {
          "match": "\\\\",
          "name": "storage.type.function.lambda.ares"
        },
        {
          "match": "=>|->",
          "name": "keyword.operator.arrow.ares"
        },
        {
          "match": "[!$%&*+\\-/:;<=>^|~]+",
          "name": "keyword.operator.ares"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.range.ares"
        },
        {
          "match": "[,.]",
          "name": "punctuation.separator.ares"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [{ "include": "#expr" }]
        }
      ]
    },
    "comment": {
      "patterns": [
        { "include": "#block-comment" },
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.ares"
        }
      ]
    },
    "block-comment": {
      "begin": "#-",
      "end": "-#",
      "name": "comment.block.ares",
      "patterns": [{ "include": "#block-comment" }]
    },
    "string": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.ares",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.ares"
        },
        {
          "begin": "\\?\\(",
          "end": "\\)",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.ares" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.ares" } },
          "contentName": "meta.embedded.line.ares",
          "name": "meta.interpolation.ares",
          "patterns": [{ "include": "#expr" }]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9a-fA-F_]+\\b|\\b0[bB][01_]+\\b",
          "name": "constant.numeric.integer.ares"
        },
        {
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?i\\b",
          "name": "constant.numeric.imaginary.ares"
        },
        {
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b",
          "name": "constant.numeric.float.ares"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.integer.ares"
        }
      ]
    },
    "at": {
      "patterns": [
        {
          "match": "@(true|false)\\b",
          "name": "constant.language.boolean.ares"
        },
        {
          "match": "@(int|nat|int8|int16|int32|int64|nat8|nat16|nat32|nat64|float32|float64|str|ptr|bool|array|vec|token|code|future|chan|tvar)\\b",
          "name": "support.type.builtin.ares"
        },
        {
          "match": "@(io|meta)\\b",
          "name": "support.type.effect.ares"
        },
        {
          "match": "@I[A-Z][A-Za-z0-9_]*\\b",
          "name": "support.type.interface.ares"
        },
        {
          "match": "@(mod|struct|union|alias|effect)\\b",
          "name": "storage.type.ares"
        },
        {
          "match": "@(main|build|e|run|ctx|private|extern)\\b",
          "name": "keyword.other.directive.ares"
        },
        {
          "match": "@[A-Za-z][A-Za-z0-9_]*\\b",
          "name": "support.function.builtin.ares"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(if|else)\\b",
          "name": "keyword.control.conditional.ares"
        },
        {
          "match": "\\b(let|in|do|ctl)\\b",
          "name": "keyword.control.ares"
        }
      ]
    }
  }
}
