$ @mod TREE_SITTER_GEN

# \file TREE_SITTER_GEN.ares
# \info Generate a tree-sitter grammar for Ares from its Bison spec,
#       documentation/syntax/ares.y, so editors that highlight through tree-sitter
#       (Helix, Zed) parse with the same grammar the spec states. Writes
#       tools/editors/tree-sitter-ares/grammar.js; `thrax tree-sitter`
#       runs this and then `tree-sitter generate` on the result.
#
#       Bison and tree-sitter are both LR, so the rules carry over almost one
#       for one. Three things do not:
#       - Tree-sitter rejects a rule that matches nothing, so an empty
#         alternative is dropped, every use of a nullable rule becomes
#         `optional(...)`, and an alternative made only of nullable rules is
#         split so that each split requires one of them.
#       - Bison gives a rule the precedence of its last terminal that has one
#         (or its `%prec`); that becomes `prec.left`/`prec.right`/`prec` with the
#         token's level.
#       - Bison names terminals but never spells them; `tokens` below does.

$ @import ARESxALGO
$ @import ARESxIO
$ @import ARESxOPT
$ @import ARESxSTR
$ @import ARESxVEC

$ spec_path : @Str = "documentation/syntax/ares.y"

$ out_dir : @Str = "tools/editors/tree-sitter-ares"

# ---- the spelling of every terminal ----------------------------------------

# A string is a literal token; `$.name` refers to a lexical rule in `lexical`.
$ tokens : @Vec { @Str, @Str } = [
    { "INT", "$.int" },
    { "REAL", "$.real" },
    { "IMAG", "$.imag" },
    { "STR", "$.str" },
    { "UIDENT", "$.uident" },
    { "LIDENT", "$.lident" },
    { "UNDERSCORE", "'_'" },
    { "HOLE", "$.hole" },
    { "AT_MOD", "'@mod'" },
    { "AT_STRUCT", "'@struct'" },
    { "AT_UNION", "'@union'" },
    { "AT_ALIAS", "'@alias'" },
    { "AT_EFFECT", "'@effect'" },
    { "AT_MAIN", "'@main'" },
    { "AT_BUILD", "'@build'" },
    { "AT_USE", "'@use'" },
    { "AT_IFACE", "$.at_iface" },
    { "AT_PRIVATE", "'@private'" },
    { "AT_IMPORT", "'@import'" },
    { "AT_EXTERN", "'@extern'" },
    { "AT_ARRAY", "'@Array'" },
    { "AT_TRUE", "'@true'" },
    { "AT_FALSE", "'@false'" },
    { "AT_TYCON", "$.at_tycon" },
    { "LPAREN", "'('" },
    { "RPAREN", "')'" },
    { "LBRACE", "'\{'" },
    { "RBRACE", "'}'" },
    { "LBRACK", "'['" },
    { "RBRACK", "']'" },
    { "LAMBDA", "'\\\\'" },
    { "EQ", "'='" },
    { "ARROW", "'->'" },
    { "FATARROW", "'=>'" },
    { "DOLLAR", "'$'" },
    { "COLON", "':'" },
    { "COMMA", "','" },
    { "DOT", "'.'" },
    { "KW_LET", "'let'" },
    { "KW_IN", "'in'" },
    { "KW_IF", "'if'" },
    { "KW_ELSE", "'else'" },
    { "KW_DO", "'do'" },
    { "KW_CTL", "'ctl'" },
    { "SEMI", "';'" },
    { "PIPE_BACK", "'<|'" },
    { "PIPE_FWD", "'|>'" },
    { "OR_OR", "'||'" },
    { "AND_AND", "'&&'" },
    { "EQEQ", "'=='" },
    { "NEQ", "'!='" },
    { "LT", "'<'" },
    { "GT", "'>'" },
    { "LE", "'<='" },
    { "GE", "'>='" },
    { "CONS", "'::'" },
    { "CONCAT", "'++'" },
    { "PLUS", "'+'" },
    { "MINUS", "'-'" },
    { "STAR", "'*'" },
    { "SLASH", "'/'" },
    { "PERCENT", "'%'" },
    { "CARET", "'^'" },
    { "AMP3", "'&&&'" },
    { "BAR3", "'|||'" },
    { "CARET3", "'^^^'" },
    { "SHL3", "'<<<'" },
    { "SHR3", "'>>>'" },
    { "TILDE3", "'~~~'" },
    { "AMP", "'&'" },
    { "COMPOSE", "'<|>'" },
    { "BANG", "'!'" },
    { "ANGLE_EMPTY", "'<>'" },
    { "BAR", "'|'" },
    { "ELLIPSIS", "'...'" },
]

# The lexical rules the named tokens above refer to, as the lexer reads them
# (crates/frontend/src/lexer.rs).
$ lexical : @Str =
    "    int: $ => /0[xX][0-9a-fA-F_]+|0[bB][01_]+|[0-9][0-9_]*/,\n"
        ++ "    real: $ => /[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?|[0-9][0-9_]*[eE][+-]?[0-9]+/,\n"
        ++ "    imag: $ => /[0-9][0-9_]*(\\.[0-9][0-9_]*)\?([eE][+-]?[0-9]+)\?i/,\n"
        ++ "    str: $ => /\"([^\"\\\\\\n]|\\\\.)*\"/,\n"
        ++ "    uident: $ => /[A-Z][A-Za-z0-9_]*/,\n"
        ++ "    lident: $ => /[a-z_][A-Za-z0-9_]*/,\n"
        ++ "    hole: $ => '???',\n"
        ++ "    at_tycon: $ => /@[A-Za-z][A-Za-z0-9_]*/,\n"
        ++ "    at_iface: $ => /@I[A-Z][A-Za-z]*/,\n"
        ++ "    comment: $ => token(choice(prec(1, /#-([^-]|-[^#])*-#/), /#[^\\n]*/)),\n"

# Where Bison's `%expect` lets shift win by default (the CONFLICTS note in the
# spec), tree-sitter asks for the choice to be made explicit. These rules
# prefer shifting: their alternatives without a precedence of their own get
# right associativity, which tree-sitter resolves as shift.
$ prefer_shift : @Vec @Str = ["handle", "ctrl_expr"]

# Rule pairs tree-sitter must explore both ways (GLR), for an ambiguity no
# precedence settles.
$ conflicts : @Vec { @Str, @Str } = []

# ---- reading the spec -------------------------------------------------------

$ Prec : @struct = name: @Str, level: @Int, assoc: @Str,

$ Header : @struct = terms: @Vec @Str, precs: @Vec Prec,

$ Alt : @struct = syms: @Vec @Str, prec: @Str,

$ Rule : @struct = name: @Str, alts: @Vec Alt,

# The declarations before the first `%%` and the rules up to the second.
$ sections : @Str -> { @Str, @Str } = \s =>
    ARES.index_of "\n%%" s |> \
        | Opt.Some.{ a } =>
            let rest = ARES.substr (a + 3) (len s) s in
            (
                ARES.index_of "\n%%" rest |> \
                    | Opt.Some.{ b } => { ARES.substr 0 a s, ARES.substr 0 b rest }
                    | _                 => { ARES.substr 0 a s, rest }
            )
        | _ => { "", s }

# Words, and the marks `:` `|` `;`, with `/* ... */` comments dropped.
$ tokenize : @Str -> @Vec @Str = \s => scan s 0 []

$ scan : @Str -> @Int -> @Vec @Str -> @Vec @Str = \s i acc =>
    if i >= len s =>
        acc
    else
        let c = ARES.at i s in
        if ARES.is_space c =>
            scan s (i + 1) acc
        else if opens_comment s i =>
            scan s (comment_end s (i + 2)) acc
        else if is_mark c =>
            scan s (i + 1) (ARES.push (ARES.from_byte c) acc)
        else
            let j = word_end s i in scan s j (ARES.push (ARES.substr i j s) acc)

$ is_mark : @Int -> @Bool = \c => c == 58 || c == 124 || c == 59

$ opens_comment : @Str -> @Int -> @Bool = \s i =>
    i + 1 < len s && ARES.at i s == 47 && ARES.at (i + 1) s == 42

$ comment_end : @Str -> @Int -> @Int = \s i =>
    ARES.index_of_from "*/" i s |> \ | Opt.Some.{ j } => j + 2 | _ => len s

$ word_end : @Str -> @Int -> @Int = \s i =>
    if i >= len s =>
        i
    else if ARES.is_space (ARES.at i s) || is_mark (ARES.at i s) || opens_comment s i =>
        i
    else
        word_end s (i + 1)

# `%token` names terminals; each `%left`/`%right`/`%precedence` line names
# terminals too and opens the next, tighter, precedence level.
$ read_header : @Vec @Str -> Header = \toks =>
    (foldl header_step { "", 0, Header.{ .terms = [], .precs = [] } } toks).2

$ header_step : { @Str, @Int, Header } -> @Str -> { @Str, @Int, Header } = \st tok =>
    let dir = st.0 in
    let level = st.1 in
    let h = st.2 in
    if ARES.starts_with "%" tok =>
        let assoc =
            tok |> \
                | "%left"       => "left"
                | "%right"      => "right"
                | "%precedence" => "none"
                | _             => ""
        in
        if assoc == "" => { tok, level, h } else { assoc, level + 1, h }
    else if dir == "%token" =>
        { dir, level, Header.{ .terms = ARES.push tok h.terms, .precs = h.precs } }
    else if dir == "left" || dir == "right" || dir == "none" =>
        let p = Prec.{ .name = tok, .level = level, .assoc = dir } in
        { dir, level, Header.{ .terms = ARES.push tok h.terms, .precs = ARES.push p h.precs } }
    else
        { dir, level, h }

# `name : alt | alt ... ;`, each alternative a run of symbols and an optional
# `%prec TOKEN`.
$ read_rules : @Vec @Str -> @Int -> @Vec Rule -> @Vec Rule = \t i acc =>
    if i + 1 >= len t =>
        acc
    else
        let r = read_alts t (i + 2) [] [] "" in
        read_rules t r.1 (ARES.push Rule.{ .name = @vec_get t i, .alts = r.0 } acc)

$ read_alts : @Vec @Str -> @Int -> @Vec Alt -> @Vec @Str -> @Str
    -> { @Vec Alt, @Int } = \t i alts syms prec =>
    let done = ARES.push Alt.{ .syms = syms, .prec = prec } alts in
    if i >= len t =>
        { done, i }
    else
        let tok = @vec_get t i in
        if tok == ";" =>
            { done, i + 1 }
        else if tok == "|" =>
            read_alts t (i + 1) done [] ""
        else if tok == "%prec" =>
            read_alts t (i + 2) alts syms (@vec_get t (i + 1))
        else
            read_alts t (i + 1) alts (ARES.push tok syms) prec

# ---- analysis ---------------------------------------------------------------

$ has : @Vec @Str -> @Str -> @Bool = \v s => ARES.contains_by ARES.eq s v

# The rules that can match nothing: grown to a fixed point from the ones with
# an alternative whose every symbol is already known nullable.
$ nullable_set : @Vec Rule -> @Vec @Str -> @Vec @Str = \rules known =>
    let next =
        foldl (\acc r =>
            if has acc r.name =>
                acc
            else if any (\a => all (has acc) a.syms) r.alts =>
                ARES.push r.name acc
            else
                acc) known rules
    in
    if len next == len known => known else nullable_set rules next

$ Ctx : @struct = terms: @Vec @Str, nullable: @Vec @Str, precs: @Vec Prec,

$ find_prec : Ctx -> @Str -> Opt Prec = \c name => find (\p => p.name == name) c.precs

# Bison's rule precedence: the `%prec` token, else the last terminal that has
# a precedence.
$ alt_prec : Ctx -> Alt -> Opt Prec = \c a =>
    if !(a.prec == "") =>
        find_prec c a.prec
    else
        foldl (\acc s => find_prec c s |> \ | Opt.Some.{ p } => Opt.Some.{ p } | _ => acc)
            Opt.None a.syms

# Terminals the rules use that `tokens` does not spell.
$ unmapped : Ctx -> @Vec Rule -> @Vec @Str = \c rules =>
    let used = ARES.flat_map (\r => ARES.flat_map (\a => a.syms) r.alts) rules in
    foldl (\acc s =>
        if has c.terms s && is_none (ARES.lookup_by ARES.eq s tokens) && !(has acc s) =>
            ARES.push s acc
        else
            acc) [] used

# ---- writing grammar.js -----------------------------------------------------

$ seq_js : @Vec @Str -> @Str = \parts =>
    if len parts == 1 => @vec_get parts 0 else "seq(" ++ ARES.join ", " parts ++ ")"

$ choice_js : @Vec @Str -> @Str = \parts =>
    if len parts == 1 =>
        @vec_get parts 0
    else
        "choice(\n      " ++ ARES.join ",\n      " parts ++ ",\n    )"

$ token_js : @Str -> @Str = \s => unwrap_or s (ARES.lookup_by ARES.eq s tokens)

$ sym_js : Ctx -> @Str -> @Str = \c s =>
    if has c.terms s =>
        token_js s
    else if has c.nullable s =>
        "optional($." ++ s ++ ")"
    else
        "$." ++ s

# An alternative of nullable rules only, as one choice per rule it starts at:
# that rule required, the ones after it optional.
$ expansions : Ctx -> @Vec @Str -> @Int -> @Vec @Str = \c syms i =>
    if i >= len syms =>
        []
    else
        let rest = fmap (sym_js c) (drop (i + 1) syms) in
        append (expansions c syms (i + 1)) [seq_js (append rest ["$." ++ @vec_get syms i])]

$ wrap_prec : Ctx -> @Str -> Alt -> @Str -> @Str = \c rule a body =>
    alt_prec c a |> \
        | Opt.Some.{ p } =>
            let f =
                p.assoc |> \
                    | "left"  => "prec.left"
                    | "right" => "prec.right"
                    | _       => "prec"
            in
            f ++ "(" ++ to_string p.level ++ ", " ++ body ++ ")"
        | _ => if has prefer_shift rule => "prec.right(" ++ body ++ ")" else body

$ alt_js : Ctx -> @Str -> Alt -> Opt @Str = \c rule a =>
    if is_empty a.syms =>
        Opt.None
    else if all (has c.nullable) a.syms =>
        Opt.Some.{ wrap_prec c rule a (choice_js (expansions c a.syms 0)) }
    else
        Opt.Some.{ wrap_prec c rule a (seq_js (fmap (sym_js c) a.syms)) }

$ rule_js : Ctx -> Rule -> @Str = \c r =>
    "    " ++ r.name ++ ": $ => " ++ choice_js (filter_map (alt_js c r.name) r.alts) ++ ",\n"

$ conflicts_js : @Str =
    concat (fmap (\p => "    [$." ++ p.0 ++ ", $." ++ p.1 ++ "],\n") conflicts)

$ grammar_js : Ctx -> @Vec Rule -> @Str = \c rules =>
    "// AUTOGENERATED by tools/editors/TREE_SITTER_GEN.ares from documentation/syntax/ares.y.\n"
        ++ "// Do not edit: change the spec or the generator, then run `thrax tree-sitter`.\n\n"
        ++ "module.exports = grammar(\{\n"
        ++ "  name: 'ares',\n"
        ++ "  word: $ => $.lident,\n"
        ++ "  extras: $ => [/\\s/, $.comment],\n"
        ++ "  conflicts: $ => [\n"
        ++ conflicts_js
        ++ "  ],\n"
        ++ "  rules: \{\n"
        ++ concat (fmap (rule_js c) rules)
        ++ lexical
        ++ "  },\n"
        ++ "});\n"

$ @main : @Vec @Str -> <@IO> @Int = \args =>
    ARES.read_file spec_path |> \
        | Opt.Some.{ src } =>
            let parts = sections src in
            let h = read_header (tokenize parts.0) in
            let rules = read_rules (tokenize parts.1) 0 [] in
            let c = Ctx.{ .terms = h.terms, .nullable = nullable_set rules [], .precs = h.precs } in
            let missing = unmapped c rules in
            if !(is_empty missing) =>
                ARES.eprintln
                    ("TREE_SITTER_GEN: no tree-sitter spelling for: " ++ ARES.join ", " missing);
                1
            else
                C.system ("mkdir -p " ++ out_dir);
                if ARES.write_file (out_dir ++ "/grammar.js") (grammar_js c rules) =>
                    ARES.println
                        (
                            "TREE_SITTER_GEN: wrote "
                                ++ out_dir
                                ++ "/grammar.js ("
                                ++ to_string (len rules)
                                ++ " rules)"
                        );
                    0
                else
                    1
        | _ => ARES.eprintln ("TREE_SITTER_GEN: cannot read " ++ spec_path); 1
